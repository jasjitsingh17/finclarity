# Frontend (Vite)
# Local development default:
VITE_API_BASE_URL=http://127.0.0.1:8010

# Backend CORS
# Comma-separated allowed browser origins.
# If unset, the backend defaults to the two local Vite origins.
FINCLARITY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production examples:
# VITE_API_BASE_URL=https://your-finclarity-api.example.com
# FINCLARITY_CORS_ORIGINS=https://your-finclarity-site.example.com
